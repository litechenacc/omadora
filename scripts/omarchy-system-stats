#!/usr/bin/env bash
# Omadora compatibility implementation of omarchy-system-stats.
# Outputs the small key/value protocol consumed by Omarchy Quickshell.
set -euo pipefail

usage() { echo "Usage: omarchy-system-stats [--bar-widget]" >&2; }

cpu_ticks() {
  awk '$1 == "cpu" { idle = $5; total = 0; for (i = 2; i <= NF; i++) total += $i; printf "%.0f %.0f\n", idle, total; exit }' /proc/stat
}

memory_stats() {
  awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { available = $2 }
    END { if (total > 0) printf "%.2f %.1f %.0f\n", ((total - available) / total) * 100, (total - available) / 1024 / 1024, total / 1024 / 1024 }
  ' /proc/meminfo
}

case "${1:-}" in
  "")
    read -r idle1 total1 < <(cpu_ticks)
    sleep 0.1
    read -r idle2 total2 < <(cpu_ticks)
    cpu=$(awk -v i1="$idle1" -v t1="$total1" -v i2="$idle2" -v t2="$total2" \
      'BEGIN { dt=t2-t1; di=i2-i1; if (dt > 0) printf "%.0f%%", (1-di/dt)*100; else print "0%" }')
    read -r _used_pct used_gb total_gb < <(memory_stats)
    printf 'cpu\t%s\n' "$cpu"
    printf 'memory\t%.1fGB / %.0fGB\n' "$used_gb" "$total_gb"
    ;;
  --bar-widget)
    read -r idle total < <(cpu_ticks)
    printf 'cpu\t%s\t%s\n' "$idle" "$total"
    read -r used_pct _used_gb _total_gb < <(memory_stats)
    printf 'memory\t%s\n' "$used_pct"
    awk '{ printf "load\t%s\n", $1 }' /proc/loadavg
    ;;
  -h|--help)
    usage; exit 0
    ;;
  *)
    usage; exit 1
    ;;
esac
